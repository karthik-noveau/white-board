# Set the real HTTPS origin before running npm run build:production.
# Leave empty for a local or unindexed preview build.
VITE_PUBLIC_APP_URL=

# On other preview hosts, set DEPLOYMENT_ENV=preview in the build environment
# to suppress indexing even when a production URL is inherited.
# Netlify and Vercel preview environments are detected automatically.

# Optional public verification tokens from Google Search Console / Bing Webmaster Tools.
# These are rendered only on the indexed homepage; they are not API credentials.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
